# Configuracion de proveedor LLM para el SDK de OpenAI Agents
# Puedes utilizar NVIDIA NIM, Groq u OpenAI

# Opcion 1: NVIDIA Build / NIM (Recomendada si dispones de API key de NVIDIA)
NVIDIA_API_KEY=nvapi-tu_api_key_aqui
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Opcion 2: Groq
# GROQ_API_KEY=gsk_tu_api_key_aqui
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# Opcion 3: OpenAI Oficial
# OPENAI_API_KEY=sk-tu_api_key_aqui
# MODEL=gpt-4o-mini
